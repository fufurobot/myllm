# myllm environment configuration.
#
# Copy this file to `.env` and adjust the values for your machine:
#     cp .env.example .env
#
# `.env` is gitignored, so your secrets stay local. The devcontainer's
# post-create script also creates `.env` from this template automatically.

# ---------------------------------------------------------------------------
# Hugging Face endpoint
# ---------------------------------------------------------------------------
# Mirror used by download-hf.sh / hfd.sh for both metadata and downloads.
# Use https://huggingface.co if you are not behind a restrictive network.
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------------------
# Hugging Face authentication
# ---------------------------------------------------------------------------
# Required only for gated or private repositories.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Username paired with HF_TOKEN; hfd.sh asks for both on gated repos.
HF_USERNAME=

# ---------------------------------------------------------------------------
# Download behaviour (read by download-hf.sh)
# ---------------------------------------------------------------------------
# Extra flags forwarded verbatim to hfd.sh, e.g.:
#     HFD_EXTRA_ARGS=--hf_token hf_xxx
#     HFD_EXTRA_ARGS=--tool aria2c -x 16
HFD_EXTRA_ARGS=

# Path to the hfd.sh downloader script.
HFD_SCRIPT=./hfd.sh

# Set to true to print the download commands without executing them.
DRY_RUN=false

# ---------------------------------------------------------------------------
# PyTorch backend (used by .devcontainer/post-create.sh)
# ---------------------------------------------------------------------------
# "cpu" for CPU-only wheels, or "cu118" for NVIDIA CUDA 11.8 wheels.
# Codespaces runners have no GPU, so "cpu" is the default there.
TORCH_BACKEND=cpu
